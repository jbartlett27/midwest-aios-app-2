{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/task-reminders", "schedule": "0 12 * * *" }
  ],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index?route=mcp" },
    { "source": "/register", "destination": "/api/index?route=register" },
    { "source": "/authorize", "destination": "/api/index?route=authorize" },
    { "source": "/token", "destination": "/api/index?route=token" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/index?route=.well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/index?route=.well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/index?route=.well-known/oauth-authorization-server" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/index?route=.well-known/oauth-authorization-server" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/index?route=.well-known/openid-configuration" }
  ]
}
